{
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "../frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "../frontend/dist" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "functions": {
    "../**": {
      "excludeFiles": "{.next,*.cache,node_modules,public,app,*.engine,*.onnx,training,frontend}/**"
    },
    "backend/**": "*",
    "frontend/**": "*",
    "../backend/**": "*",
    "../frontend/**": "*"
  }
}
