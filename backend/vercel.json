{
  "builds": [
    {
      "src": "app/main_vercel.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main_vercel.py"
    }
  ]
}
